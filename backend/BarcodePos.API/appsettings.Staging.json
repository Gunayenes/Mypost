{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/CariSoft_Staging.db",
    "LicenseConnection": "Data Source=App_Data/licenses_staging.db"
  },
  "JwtSettings": {
    "Issuer": "CariSoft-Staging",
    "Audience": "CariSoftClients-Staging",
    "ExpirationInMinutes": 720
  },
  "AllowedOrigins": "https://test.cari-soft.com",
  "AppBaseUrl": "https://test.cari-soft.com",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5050"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Environment": {
    "Name": "Staging",
    "ShowBanner": true
  }
}
