# ═══════════════════════════════════════════════════
# Cari Soft API — Production Ortam Değişkenleri
# ═══════════════════════════════════════════════════
# Bu dosyayı `.env` olarak kopyalayıp değerleri doldurun.
# Sunucu ortam değişkenleri olarak da ayarlanabilir.

# ── Ortam ──
ASPNETCORE_ENVIRONMENT=Production

# ── JWT Güvenlik ──
# En az 32 karakter uzunluğunda güçlü bir secret key
JWT_SECRET=BURAYA-GUCLU-BIR-SECRET-KEY-YAZIN-MIN-32-CHAR!!

# ── Site Admin Kimlik Bilgileri ──
SITE_ADMIN_EMAIL=admin@sizindomain.com
SITE_ADMIN_PASSWORD=GucluBirSifre123!

# ── CORS — İzin Verilen Frontend Origin'leri ──
# Birden fazla origin virgülle ayrılır
ALLOWED_ORIGINS=https://sizindomain.com,https://www.sizindomain.com

# ── E-posta (SMTP) Ayarları ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=sizin@gmail.com
SMTP_PASS=uygulama-sifresi
SMTP_FROM_EMAIL=noreply@cari-soft.com
SMTP_FROM_NAME=Cari Soft

# ── Uygulama Base URL (e-posta linkleri için) ──
APP_BASE_URL=https://sizindomain.com

# ── Sunucu Port (opsiyonel — Railway/Docker için) ──
# PORT=5050
