{
  "appId": "com.carisoft.app",
  "productName": "Cari Soft",
  "directories": {
    "output": "electron-dist"
  },
  "files": [
    "dist/**/*",
    "electron.cjs",
    "preload.cjs",
    "auto-updater.cjs",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "../../Cari Soft-Setup",
      "to": "backend",
      "filter": ["**/*", "!logs/**", "!*.log"]
    }
  ],
  "win": {
    "icon": "public/icon.png",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "Cari Soft",
    "menuCategory": "Cari Soft",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "uninstallDisplayName": "Cari Soft Satış Noktası"
  },
  "compression": "normal",
  "publish": [
    {
      "provider": "github",
      "owner": "Gunayenes",
      "repo": "Mypost",
      "releaseType": "release"
    }
  ]
}
